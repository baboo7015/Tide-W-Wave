{
  "manifest_version": 3,
  "name": "Tide-W-Wave Assistant",
  "version": "2.0.0",
  "description": "Плавающий торговый оверлей и калькулятор рисков (Элдер + VWAP + EMA).",
  "action": {
    "default_title": "Открыть Tide-W-Wave"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mexc.com/*",
        "*://*.tradingview.com/*",
        "*://*.coinglass.com/*",
        "*://*.bingx.com/*",
        "*://*.bybit.com/*",
        "*://*.binance.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Открыть/закрыть калькулятор"
    }
  }
}